{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "scanner", "callback", "paperless", "persistence"],
  "properties": {
    "replicaCount": {"type": "integer", "enum": [0, 1]},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "additionalProperties": false
    },
    "scanner": {
      "type": "object",
      "required": ["printerIP", "destination", "buttonSource", "insecureTLS"],
      "properties": {
        "printerIP": {"type": "string", "format": "ipv4", "minLength": 1},
        "destination": {"type": "string", "pattern": "^[a-zA-Z0-9 _-]{1,32}$"},
        "buttonSource": {"enum": ["feeder", "platen"]},
        "insecureTLS": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "callback": {
      "type": "object",
      "required": ["address", "port"],
      "properties": {
        "address": {"type": "string", "format": "ipv4", "minLength": 1},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "paperless": {
      "type": "object",
      "required": ["url", "existingSecret", "tokenKey"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://[^?#]+/$"},
        "existingSecret": {"type": "string", "minLength": 1},
        "tokenKey": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["existingClaim", "size", "accessModes"],
      "properties": {
        "existingClaim": {"type": "string"},
        "storageClass": {"type": ["string", "null"]},
        "size": {"type": "string", "minLength": 1},
        "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod"]}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "extraEnv": {"type": "array"},
    "envFrom": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 25},
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
